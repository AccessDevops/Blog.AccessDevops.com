# Clé publique PostHog, côté navigateur (sans risque à exposer : elle ne
# permet que d'envoyer des événements, pas de les lire).
# Même projet que le site produit et l'application desktop, pour que
# l'entonnoir blog → site → installation s'écrive en une seule requête.
NUXT_PUBLIC_POSTHOG_KEY=phc_votre_cle_de_projet
